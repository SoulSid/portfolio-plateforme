# Gabarit des variables d'environnement.
# Copiez ce fichier en .env.local et remplissez les valeurs.
# .env.local n'est JAMAIS versionné : aucun secret ne doit entrer dans le dépôt.

# ── Base de données ──────────────────────────────────────────────────────
# Neon : Dashboard → votre projet → Connection string (choisir « Pooled »).
# Format : postgresql://UTILISATEUR:MOTDEPASSE@HOTE/BASE?sslmode=require
DATABASE_URL=

# ── Authentification (Auth.js v5) ────────────────────────────────────────
# Générer avec : npx auth secret
AUTH_SECRET=
# URL publique du site. En local : http://localhost:3000
AUTH_URL=http://localhost:3000
# Hors Vercel (Netlify, VPS), Auth.js refuse les requêtes tant que l'hôte
# n'est pas déclaré de confiance. Inutile en local, OBLIGATOIRE sur Netlify.
AUTH_TRUST_HOST=true

# Compte administrateur unique, créé par le seed (Phase 1).
# Choisissez un mot de passe long ; il est haché avec bcrypt avant insertion.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── Médias (Cloudinary) — utilisé à partir de la Phase 3 ─────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Exposé au navigateur : nom du cloud uniquement, jamais les clés.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── E-mail (Resend) — utilisé à partir de la Phase 5 ─────────────────────
RESEND_API_KEY=
# Adresse qui reçoit les messages du formulaire de contact.
CONTACT_NOTIFY_EMAIL=

# ── Divers ───────────────────────────────────────────────────────────────
# URL canonique du site, pour le sitemap, le RSS et les images Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Jeton d'aperçu des brouillons (/labs/[slug]?preview=…). Chaîne aléatoire longue.
PREVIEW_TOKEN=
